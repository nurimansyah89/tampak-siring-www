# ============================================
# Server-side (credentials) — diisi manual
# ============================================
API_KEY=your-api-key-here
DB_URL=mongodb://localhost:27017/tampaksiring
JWT_SECRET=change-this-secret

# ============================================
# Server-side (non-sensitive) — di-load ke client via /api/config
# ============================================
API_BASE_URL=http://localhost:4000/api
MAINTENANCE_MODE=false

# ============================================
# Server port
# ============================================
PORT=4000
